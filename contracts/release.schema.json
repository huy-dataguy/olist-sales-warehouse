{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sales-dw:release:2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "source_cut",
    "source_artifact_hashes",
    "contract_version",
    "model_version",
    "semantic_manifest_sha256",
    "fencing_token",
    "state",
    "checks",
    "warehouse_snapshot",
    "metric_exports"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_cut": {
      "type": "integer",
      "minimum": 1
    },
    "source_artifact_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "contract_version": {
      "const": "2.0.0"
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "semantic_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "building",
        "warehouse_validated",
        "snapshotted",
        "metrics_validated",
        "published",
        "failed"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^V-[0-9]+$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "pending"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "warehouse_snapshot": {
      "type": "object",
      "required": [
        "relation_count",
        "row_count",
        "validated",
        "relation_ids"
      ],
      "properties": {
        "relation_count": {
          "const": 10
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "validated": {
          "type": "boolean"
        },
        "relation_ids": {
          "type": "array",
          "items": {
            "enum": [
              "dim_customer",
              "dim_product",
              "dim_seller",
              "dim_buyer_geography",
              "dim_date",
              "dim_order_status",
              "dim_payment_method",
              "fct_orders",
              "fct_order_items",
              "fct_payments"
            ]
          },
          "uniqueItems": true,
          "minItems": 10,
          "maxItems": 10
        }
      },
      "additionalProperties": false
    },
    "metric_exports": {
      "type": "object",
      "required": [
        "export_count",
        "parity_passed",
        "export_ids"
      ],
      "properties": {
        "export_count": {
          "type": "integer",
          "minimum": 1
        },
        "parity_passed": {
          "type": "boolean"
        },
        "export_ids": {
          "type": "array",
          "items": {
            "enum": [
              "sales_monthly",
              "sales_daily",
              "product_monthly",
              "seller_monthly",
              "buyer_state_monthly"
            ]
          },
          "uniqueItems": true,
          "minItems": 5,
          "maxItems": 5
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "published"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            },
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "V-004"
                    },
                    "status": {
                      "const": "passed"
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "V-005"
                    },
                    "status": {
                      "const": "passed"
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "V-007"
                    },
                    "status": {
                      "const": "passed"
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "V-013"
                    },
                    "status": {
                      "const": "passed"
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "V-017"
                    },
                    "status": {
                      "const": "passed"
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ]
                }
              }
            ]
          },
          "warehouse_snapshot": {
            "properties": {
              "validated": {
                "const": true
              }
            }
          },
          "metric_exports": {
            "properties": {
              "parity_passed": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "x-required-publish-checks": [
    "V-004",
    "V-005",
    "V-007",
    "V-013",
    "V-017"
  ]
}

