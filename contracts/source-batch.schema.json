{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sales-dw:batch-envelope:1.0.0",
  "title": "Immutable source batch admission manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_system",
    "source_version",
    "artifact_sha256",
    "batch_id",
    "replay_plan_id",
    "batch_sequence",
    "schema_version",
    "received_at_utc",
    "scenario_id",
    "members"
  ],
  "properties": {
    "source_system": {
      "type": "string",
      "enum": [
        "olist",
        "synthetic_contract_fixture"
      ]
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "received_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity",
          "file_member",
          "row_count"
        ],
        "properties": {
          "entity": {
            "enum": [
              "customers",
              "orders",
              "order_items",
              "payments",
              "products",
              "sellers",
              "category_translation"
            ]
          },
          "file_member": {
            "type": "string"
          },
          "row_count": {
            "type": "integer",
            "minimum": 0
          },
          "source_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "replay_plan_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_system": {
            "const": "synthetic_contract_fixture"
          }
        }
      },
      "then": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}

